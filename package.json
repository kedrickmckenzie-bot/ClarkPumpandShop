{
  "name": "cstore-operations-suite",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "dev:render": "cross-env OPS_RUNTIME=render next dev --hostname 0.0.0.0 --port 3000",
    "build:render": "cross-env OPS_RUNTIME=render next build",
    "start:render": "cross-env OPS_RUNTIME=render next start --hostname 0.0.0.0",
    "start:render:free": "npm run render:predeploy && npm run start:render",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/ops-workflow.e2e.test.ts tests/ops-postgres-engine.integration.test.ts tests/ops-public-boundary.test.ts tests/ops-presenter-contract.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx scripts/seed-ops-platform.ts",
    "db:generate:postgres": "drizzle-kit generate --config drizzle.postgres.config.ts",
    "db:migrate:postgres": "tsx scripts/migrate-postgres.ts",
    "db:seed:postgres": "tsx scripts/seed-postgres.ts",
    "db:reset:postgres": "tsx scripts/reset-postgres.ts",
    "jobs:postgres": "tsx scripts/run-ops-jobs-postgres.ts",
    "render:predeploy": "npm run db:migrate:postgres && npm run db:seed:postgres"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@electric-sql/pglite": "0.5.5",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
