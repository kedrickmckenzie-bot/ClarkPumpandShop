# Render sets this automatically; declaring it makes the intended adapter explicit.
OPS_RUNTIME=render

# Use the Internal Database URL from this service's PostgreSQL database.
DATABASE_URL=postgresql://ops_user:replace-me@ops-db:5432/operations

# Set this to the final Render service origin before the production build.
NEXT_PUBLIC_SITE_URL=https://replace-with-service.onrender.com
PUBLIC_TOKEN_SECRET=replace-with-at-least-32-random-bytes

# Create a new private bucket for this service. Never reuse another product's credentials.
OPS_OBJECT_STORAGE_PROVIDER=s3
S3_ENDPOINT=https://replace-with-private-object-storage-endpoint
S3_REGION=us-east-1
S3_BUCKET=cstore-operations-files
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=true
S3_SERVER_SIDE_ENCRYPTION=AES256

# Render injects PORT. Do not set it in the dashboard.
HOSTNAME=0.0.0.0
