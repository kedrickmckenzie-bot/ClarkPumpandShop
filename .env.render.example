# Render sets this automatically; declaring it makes the intended adapter explicit.
TRACEOPS_RUNTIME=render

# Use the Internal Database URL from the TraceOps PostgreSQL service.
DATABASE_URL=postgresql://traceops_user:replace-me@traceops-db:5432/traceops

# Set this to the final Render service origin before the production build.
NEXT_PUBLIC_SITE_URL=https://replace-with-traceops.onrender.com
PUBLIC_TOKEN_SECRET=replace-with-at-least-32-random-bytes

# Create a new private bucket for TraceOps. Never reuse DockSafe credentials.
TRACEOPS_OBJECT_STORAGE_PROVIDER=s3
S3_ENDPOINT=https://replace-with-private-object-storage-endpoint
S3_REGION=us-east-1
S3_BUCKET=traceops-demo-files
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=true
S3_SERVER_SIDE_ENCRYPTION=AES256

# Render injects PORT. Do not set it in the dashboard.
HOSTNAME=0.0.0.0
