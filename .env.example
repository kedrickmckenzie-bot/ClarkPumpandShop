# Local development uses the deterministic in-memory repository and needs no secrets.
# Hosted Sites injects durable D1/R2 bindings from .openai/hosting.json.
DB=Cloudflare_D1_binding
FILES=Cloudflare_R2_binding

# Production-only examples; never commit real values.
PUBLIC_TOKEN_SECRET=replace-with-a-high-entropy-secret
EMAIL_PROVIDER=
EMAIL_API_KEY=

# Render production uploads use a newly created private S3-compatible bucket.
# Do not reuse a DockSafe bucket or credentials. The endpoint must use HTTPS.
TRACEOPS_OBJECT_STORAGE_PROVIDER=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional temporary credential and provider settings:
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=true
S3_SERVER_SIDE_ENCRYPTION=AES256

# Render / Node runtime. Render injects PORT; keep HOSTNAME explicit in the
# service start command so the server accepts traffic outside the container.
TRACEOPS_RUNTIME=
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=
