# Local development uses the deterministic in-memory repository and needs no secrets.
# Hosted Sites injects durable D1/R2 bindings from .openai/hosting.json.
DB=Cloudflare_D1_binding
FILES=Cloudflare_R2_binding

# Production-only examples; never commit real values.
PUBLIC_TOKEN_SECRET=replace-with-a-high-entropy-secret
EMAIL_PROVIDER=
EMAIL_API_KEY=
